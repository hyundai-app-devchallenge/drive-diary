{
  "version": 1,
  "max_join_lines": 3,
  "max_join_chars": 128,
  "majority": 0.5,
  "fuzzy_min_chars": 6,
  "wake_command_tail": ".*(?:줘|주세요|해|켜|꺼|틀어|알려|찾아)$",
  "wake_words": ["글레오", "헤이 글레오", "헤이 플레오스"],
  "wake_words_note": "글레오는 test/stt 합성 예시에서 확인. 나머지는 검증되지 않은 설정 예시이며 제품 호출어로 확정하지 않음.",
  "optout_literals": [
    "녹음하지 마", "녹음하지 말아 줘", "녹음하지 말자", "녹음하지 마세요",
    "녹음 그만해", "녹음 멈춰", "녹음 중지해", "녹음 꺼 줘",
    "기록하지 마", "기록하지 말아 줘", "기록하지 말자", "기록하지 마세요",
    "기록 그만해", "기록 멈춰", "기록 중지해", "기록 끄자",
    "저장하지 마", "저장하지 말아 줘", "저장하지 말자", "저장하지 마세요",
    "이건 저장하지 마", "이거 저장하지 말아 줘", "이번 얘기는 저장하지 마", "이 대화 저장하지 마",
    "방금 거 지워", "방금 건 지워 줘", "방금 얘기 지워", "방금 기록 삭제해",
    "직전 녹음 지워", "직전 기록 지워 줘", "이 대화 삭제해", "이 얘기는 지워 줘",
    "우리 얘기 남기지 마", "우리 대화 남기지 말자", "이 얘기는 남기지 마", "이 대화는 남기지 말자",
    "지금 거 녹음하지 마", "지금 얘기 기록하지 마", "이건 기록에서 빼 줘", "이거 녹음에서 빼 줘",
    "녹음 중단해", "기록 중단해", "녹음 끄자", "기록 꺼 줘",
    "녹음 안 했으면 좋겠어", "기록 안 했으면 좋겠어", "저장 안 했으면 좋겠어", "이건 비밀이니까 남기지 마"
  ],
  "patterns": [
    {"id": "optout.negative", "category": "optout", "mode": "search", "pattern": "(?:녹음|녹취|기록|저장)(?:은|는|을|를|도)?(?:하지|하진|하지는|해두지|해놓지|해놓진)(?:마|말아|말자|말고|않아|않았으면)"},
    {"id": "optout.stop", "category": "optout", "mode": "search", "pattern": "(?:녹음|녹취|기록)(?:은|는|을|를)?(?:그만|멈춰|중지|중단|꺼|끄자|끄고|끄세요|꺼주세요|종료)"},
    {"id": "optout.delete", "category": "optout", "mode": "search", "pattern": "(?:방금|직전|지금|조금전)(?:했던|한)?(?:거|건|꺼|것|말|얘기|대화|녹음|기록)(?:은|는|을|를)?(?:다|전부)?(?:지워|지우자|삭제|없애)"},
    {"id": "optout.conversation", "category": "optout", "mode": "search", "pattern": "(?:우리|이번|지금|방금|이)(?:의)?(?:대화|얘기|이야기|말|내용)(?:은|는|을|를)?(?:저장하지마|기록하지마|녹음하지마|남기지마|남기지말|지워|삭제|없애)"},
    {"id": "optout.exclude", "category": "optout", "mode": "search", "pattern": "(?:이건|이거|이얘기는|이대화는)(?:녹음|기록|저장)(?:에서|목록에서)(?:빼|제외)"},
    {"id": "optout.wish", "category": "optout", "mode": "search", "pattern": "(?:녹음|녹취|기록|저장)(?:은|는|을|를)?안(?:했으면|하면|해줬으면|할래)"},
    {"id": "command.climate", "category": "command", "mode": "full", "pattern": "(?:에어컨|히터|공조)(?:을|를|온도|는)?(?:[0-9]{1,2}도(?:로)?(?:맞춰|설정해|해|해줘|맞춰줘|설정해줘)?|켜|꺼|켜줘|꺼줘|틀어|틀어줘|온도(?:올려|내려)(?:줘)?)"},
    {"id": "command.navigation", "category": "command", "mode": "full", "pattern": "(?:집|회사|학교|목적지|서울역|부산역|가까운주유소|근처주차장)(?:으로|로|까지)(?:길)?(?:안내해|안내해줘|안내시작|길안내해줘|경로설정해줘|데려다줘)"},
    {"id": "command.nav_control", "category": "command", "mode": "full", "pattern": "(?:내비|내비게이션|네비|길안내|경로안내)(?:를|는|을)?(?:켜|꺼|켜줘|꺼줘|시작해|종료해|취소해|중지해|다시시작해)(?:줘)?"},
    {"id": "command.volume", "category": "command", "mode": "full", "pattern": "(?:볼륨|음량)(?:을|좀|을좀)?(?:올려|내려|줄여|높여|낮춰|[0-9]{1,2}(?:으로|로)맞춰)(?:줘|주세요)?"},
    {"id": "command.media", "category": "command", "mode": "full", "pattern": "(?:음악|노래|라디오|미디어)(?:를|는|좀|를좀)?(?:켜|꺼|틀어|멈춰|정지해|재생해|일시정지해)(?:줘|주세요)?"},
    {"id": "command.track", "category": "command", "mode": "full", "pattern": "(?:(?:다음|이전)곡(?:으로)?(?:넘겨|바꿔|넘겨줘|바꿔줘)|(?:재생|통화)(?:을|를)?(?:중지|종료|취소)해(?:줘)?)"},
    {"id": "command.phone", "category": "command", "mode": "full", "pattern": "(?:엄마|아빠|할머니|할아버지|집|민수)(?:한테|에게|으로|로)(?:전화해|전화걸어|전화걸어줘|전화해줘)"},
    {"id": "external.navigation", "category": "external", "mode": "full", "pattern": "(?:(?:[0-9]+|삼백|오백|백|이백)(?:미터|킬로미터)(?:앞|후)(?:에서)?|잠시후|이어서)(?:좌회전|우회전|유턴|직진)(?:입니다|하세요|하십시오|하시기바랍니다)"},
    {"id": "external.nav_notice", "category": "external", "mode": "full", "pattern": "(?:앞에단속구간입니다|목적지에도착했습니다|경로를재탐색합니다|안전운전하세요|제한속도[0-9]+킬로미터구간입니다)"},
    {"id": "external.radio_letter", "category": "external", "mode": "full", "pattern": "(?:청취자(?:분)?|[가-힣]{2,4}님)(?:께서|이|가|의|이보내주신|께서보내주신)(?:보내주신|보내온|신청하신)?(?:사연|신청곡)(?:을|이|입니다|소개합니다|도착했습니다|들려드립니다|읽어드릴게요|을소개합니다|을읽어드립니다).*"},
    {"id": "external.radio_intro", "category": "external", "mode": "full", "pattern": "(?:지금부터|오늘은|다음은)(?:청취자)?[가-힣]{2,4}님의사연(?:입니다|을소개합니다|을읽어드립니다).*"}
  ]
}

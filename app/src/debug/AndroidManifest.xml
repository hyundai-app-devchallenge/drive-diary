<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만 들어가는 설정. 출시용(release) 앱에는 포함되지 않는다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility for the optional document picker availability check. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application>
        <activity
            android:name=".debug.DebugGleoVoiceActivity"
            android:exported="false"
            android:theme="@style/Theme.DebugVoiceSession" />

        <!-- 에뮬레이터에서 내비 도착을 흉내 내는 테스트용 수신기 -->
        <receiver
            android:name=".navi.DebugArrivalReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dongbantest.app.DEBUG_ARRIVAL" />
            </intent-filter>
        </receiver>

        <!-- 에뮬레이터에서 길 리본 진행률(차 아이콘 위치)을 흉내 내는 테스트용 수신기 -->
        <receiver
            android:name=".navi.DebugProgressReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dongbantest.app.DEBUG_PROGRESS" />
            </intent-filter>
        </receiver>

        <!-- 에뮬레이터에서 기어 D/P(주행 중/정차 중)를 흉내 내는 테스트용 수신기 -->
        <receiver
            android:name=".vehicle.DebugGearReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dongbantest.app.DEBUG_GEAR" />
            </intent-filter>
        </receiver>

        <!-- 다이어리 사진 칸 확인용: 기록에 예시 사진을 붙이는 테스트용 수신기 (adb 로 쓸 때) -->
        <receiver
            android:name=".debug.DebugPhotoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dongbantest.app.DEBUG_ADD_PHOTOS" />
            </intent-filter>
        </receiver>

        <!-- GPX 경로 파일을 끝난 여행으로 넣는 테스트용 수신기 (adb 로 쓸 때) -->
        <receiver
            android:name=".debug.DebugGpxImportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dongbantest.app.DEBUG_IMPORT_GPX" />
            </intent-filter>
        </receiver>

        <!-- talk-rec 연동(I5b): 대화 요약 설정 화면. 디버그 전용(런처 아이콘 없음, 동반차 디버그에서 연다) -->
        <activity
            android:name=".debug.SummarySettingsActivity"
            android:exported="false"
            android:taskAffinity="com.dongbantest.app.debugtools"
            android:label="대화 요약 설정"
            android:theme="@style/Theme.Dongbantest" />

        <!-- 지도 설정: Mapbox 공개 토큰을 빌드 없이 넣는다. 디버그 전용 -->
        <activity
            android:name=".debug.MapSettingsActivity"
            android:exported="false"
            android:taskAffinity="com.dongbantest.app.debugtools"
            android:label="지도 설정"
            android:theme="@style/Theme.Dongbantest" />

        <activity
            android:name=".debug.TalkRecLabActivity"
            android:exported="false"
            android:taskAffinity="com.dongbantest.app.debugtools"
            android:label="인식 실험실"
            android:theme="@style/Theme.Dongbantest" />

        <activity
            android:name=".debug.QuestionLabActivity"
            android:exported="false"
            android:taskAffinity="com.dongbantest.app.debugtools"
            android:label="질문 실험실"
            android:theme="@style/Theme.Dongbantest" />

        <!-- 조용할 때 묻기(question-suggest)를 adb 로 흉내 내는 테스트용 수신기 -->
        <receiver
            android:name=".debug.DebugQuestionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dongbantest.app.debug.ASK_FORCE_QUIET" />
                <action android:name="com.dongbantest.app.debug.ASK_FORCE_QUESTION" />
                <action android:name="com.dongbantest.app.debug.ASK_REACTION" />
                <action android:name="com.dongbantest.app.debug.ASK_SHORT_POLICY" />
                <action android:name="com.dongbantest.app.debug.ASK_VOICE" />
                <action android:name="com.dongbantest.app.debug.ASK_GLEO" />
            </intent-filter>
        </receiver>

        <!-- 개발 도구: 런처에 "동반차 디버그" 아이콘으로 따로 보인다.
             taskAffinity 를 따로 둬서, 디버그 화면을 연 뒤 "동반차" 아이콘을 눌러도 본 앱이 열리게 한다. -->
        <activity
            android:name=".debug.V3CatalogActivity"
            android:exported="true"
            android:label="동반차 디버그"
            android:icon="@mipmap/ic_debug_launcher"
            android:roundIcon="@mipmap/ic_debug_launcher"
            android:taskAffinity="com.dongbantest.app.debugtools"
            android:theme="@style/Theme.Dongbantest">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

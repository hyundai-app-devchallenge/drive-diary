<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만 들어가는 설정. 출시용(release) 앱에는 포함되지 않는다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 에뮬레이터에서 내비 도착을 흉내 내는 테스트용 수신기 -->
        <receiver
            android:name=".navi.DebugArrivalReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dongbantest.app.DEBUG_ARRIVAL" />
            </intent-filter>
        </receiver>

        <!-- GPX 경로 파일을 끝난 여행으로 넣는 테스트용 수신기 (adb 로 쓸 때) -->
        <receiver
            android:name=".debug.DebugGpxImportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dongbantest.app.DEBUG_IMPORT_GPX" />
            </intent-filter>
        </receiver>

        <!-- 개발 도구(예시 여행 넣기, v3 화면 목록): 런처에 "동반차 디버그" 아이콘으로 따로 보인다 -->
        <activity
            android:name=".debug.V3CatalogActivity"
            android:exported="true"
            android:label="동반차 디버그"
            android:theme="@style/Theme.Dongbantest">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
